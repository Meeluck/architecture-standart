flowchart LR

subgraph L1["Клиент"]
    C1[Уточняет условия открытия депозита]
    C2[Получает СМС с согласованной ставкой]
    C3[Приходит в отделение]
    C4[Получает ставку от сотрудника отделения]
end

subgraph L2["Кол-центр"]
    CC1[Оператор кол-центра банка]
    PCC1[Оператор партнёрского кол-центра]
end

subgraph L3["Фронт-офис отделения"]
    FO1[Сотрудник фронт-офиса]
    FOCHK[Проверяет в АБС,\nопределена ли ставка]
    FO2[Озвучивает ставку клиенту]
    FO3[Создаёт депозит в АБС]
    FO4[Оформляет и загружает документы]
end

subgraph L4["Бэк-офис депозитных продуктов"]
    DBO1[Сотрудник бэк-офиса депозитных продуктов]
    DBO2[Обрабатывает заявку]
    DBO3[Определяет обычную ставку]
    DBO4[Запрашивает данные по кредитному риску]
    DBO5[Рассчитывает специальную ставку]
end

subgraph L5["Бэк-офис кредитных продуктов"]
    CBO1[Сотрудник бэк-офиса кредитных продуктов]
    CBO2[Анализирует кредитный риск]
end

subgraph L6["Системы и инструменты"]
    SYSCC[Система кол-центра]
    SYSPCC[Система партнёрского кол-центра]
    ABS[АБС]
    MAIL[Корпоративная почта]
    XLS[Excel-файл расчёта ставок]
    SMSGW[СМС-шлюз]
    TELCO[Телеком-оператор]
end

START{Есть предварительное обращение\nв кол-центр?}

C1 --> START

START -->|Да, в кол-центр банка| CC1
START -->|Да, в партнёрский кол-центр| PCC1
START -->|Нет| C3

CC1 -->|Регистрирует обращение| SYSCC
PCC1 -->|Регистрирует обращение| SYSPCC

SYSCC -->|Передаёт обращение / заявку| ABS
SYSPCC -->|Передаёт обращение / заявку| ABS

ABS -->|Заявка доступна для обработки| DBO1
DBO1 --> DBO2
DBO2 -->|Фиксирует ставку в системе| ABS
ABS -->|Передаёт сообщение| SMSGW
SMSGW -->|Отправляет СМС| TELCO
TELCO -->|Доставляет СМС клиенту| C2
C2 --> C3

C3 --> FO1
FO1 -->|Запрашивает данные клиента / заявки| ABS
ABS --> FOCHK

FOCHK --> CHECK1{Ставка уже\nопределена заранее?}

CHECK1 -->|Да| FO2
CHECK1 -->|Нет| MAIL

MAIL -->|Письмо с запросом ставки| DBO1
DBO1 --> DBO2
DBO2 -->|Просматривает данные клиента| ABS

DBO2 --> CHECK2{Нужна специальная ставка?}

CHECK2 -->|Нет| DBO3
DBO3 -->|Письмо с обычной ставкой| MAIL
MAIL --> FO2

CHECK2 -->|Да| DBO4
DBO4 -->|Письмо с запросом\nданных по риску| MAIL
MAIL --> CBO1
CBO1 --> CBO2
CBO2 -->|Анализирует риск в своём контуре| ABS
CBO2 -->|Письмо с данными\nпо кредитному риску| MAIL
MAIL --> DBO5
DBO5 -->|Расчёт специальной ставки| XLS
DBO5 -->|Письмо со специальной ставкой| MAIL
MAIL --> FO2

FO2 --> C4
C4 --> FO3
FO3 --> ABS
FO3 --> FO4
FO4 --> ABS
@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

title Схема интеграции приложений процесса открытия депозита

Person(customer, "Клиент")
Person(callOperator, "Оператор кол-центра")
Person(branchEmployee, "Сотрудник фронт-офиса отделения")
Person(depositBackoffice, "Сотрудник бэк-офиса депозитных продуктов")
Person(creditBackoffice, "Сотрудник бэк-офиса кредитных продуктов")

System_Boundary(bank, "Банк «Стандарт»") {
  Container(callCenterSystem, "Система кол-центра", "Web-приложение", "Регистрация обращений клиентов")
  Container(abs, "АБС", "Delphi + Oracle + PL/SQL", "Основная банковская система")
  ContainerDb(excelCalc, "Excel-файл расчёта ставок", "Excel", "Локальный расчёт ставок")
  Container(mail, "Электронная почта", "Mail system", "Обмен запросами и результатами")
  Container(smsGateway, "СМС-шлюз", "Интеграционный сервис", "Передача СМС оператору")
}

System_Ext(telco, "Телеком-оператор", "Внешний сервис доставки СМС")

Rel(customer, callOperator, "Уточняет условия открытия депозита")
Rel(callOperator, callCenterSystem, "Заводит обращение")
Rel(callCenterSystem, abs, "Передаёт заявку по депозиту")

Rel(customer, branchEmployee, "Приходит для открытия депозита")
Rel(branchEmployee, abs, "Оформляет депозит и документы")
Rel(branchEmployee, mail, "Запрашивает ставку")

Rel(depositBackoffice, abs, "Обрабатывает заявки")
Rel(depositBackoffice, excelCalc, "Рассчитывает ставку")
Rel(depositBackoffice, mail, "Получает/отправляет письма")

Rel(creditBackoffice, abs, "Анализирует кредитный риск")
Rel(creditBackoffice, mail, "Передаёт данные по риску")

Rel(abs, smsGateway, "Передаёт данные для СМС")
Rel(smsGateway, telco, "Передаёт сообщение")
Rel(telco, customer, "Доставляет СМС")

Rel(abs, excelCalc, "Данные используются для расчёта", "Ручной перенос")
Rel(mail, depositBackoffice, "Письма")
Rel(mail, branchEmployee, "Письма")
Rel(mail, creditBackoffice, "Письма")

SHOW_LEGEND()
@enduml